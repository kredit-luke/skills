{
  "name": "workspace-dashboard",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local workspace console: runs, issues, apps, worktrees, search. Server: plain Node running TypeScript directly (type stripping). UI: Angular.",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "server": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "dev": "ng serve --proxy-config web/proxy.conf.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.app.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.ts\" && vitest run --config web/vitest.config.ts"
  },
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
