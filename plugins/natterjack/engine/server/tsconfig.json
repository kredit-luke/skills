{
  // Type-check only: Node runs these .ts files directly (type stripping), so the
  // code must stay erasable (no enums, namespaces or parameter properties) and
  // relative imports carry their .ts extension.
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Non-strict: most modules are ports of working JS. The shared API types
    // (../shared/api.ts) are what keeps server and UI in step.
    "strict": false,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../shared/**/*.ts"]
}
